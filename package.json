{
  "name": "bagsy-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @bagsy/api dev",
    "db:generate": "pnpm --filter @bagsy/api db:generate",
    "db:migrate": "pnpm --filter @bagsy/api db:migrate",
    "start": "pnpm --filter @bagsy/api start"
  }
}

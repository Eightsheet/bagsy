# Server
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/repo_org

# Bootstrap without WorkOS (local / first Railway bring-up)
DEV_AUTH=1
SKIP_GITHUB_VERIFY=1

# WorkOS AuthKit (optional until configured)
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# Optional server-side GitHub verify token
# GITHUB_VERIFY_TOKEN=

{
  "name": "@bagsy/cli",
  "version": "0.2.0",
  "description": "Bagsy — claim work on shared repos so agents and humans don't duplicate effort",
  "type": "module",
  "bin": {
    "bagsy": "./dist/bagsy.js",
    "workboard": "./dist/bagsy.js"
  },
  "files": [
    "dist/bagsy.js",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/bagsy.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eightsheet/bagsy.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Eightsheet/bagsy#readme",
  "bugs": {
    "url": "https://github.com/Eightsheet/bagsy/issues"
  },
  "keywords": [
    "bagsy",
    "workboard",
    "agents",
    "cli",
    "coordination",
    "claims"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@repo-org/shared": "workspace:*",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
